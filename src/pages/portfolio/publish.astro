---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---

<MainGridLayout title="发布作品" description="隐藏的作品墙发布页面">
	<meta slot="head" name="robots" content="noindex,nofollow" />

	<section class="moment-shell card-base">
		<form id="publish-form" class="moment-form">
			<header class="moment-topbar">
				<a href="/portfolio/" aria-label="取消">取消</a>
				<button id="publish-button" type="submit">发表</button>
			</header>

			<textarea id="description-input" maxlength="500" rows="6" placeholder="这一刻的想法..."></textarea>

			<div id="preview-grid" class="preview-grid">
				<label class="add-tile" aria-label="添加图片">
					<input id="image-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
					<span>+</span>
				</label>
			</div>

			<p id="publish-status" class="status" aria-live="polite"></p>
		</form>
	</section>
</MainGridLayout>

<script>
	const form = document.getElementById("publish-form");
	const descriptionInput = document.getElementById("description-input");
	const imageInput = document.getElementById("image-input");
	const previewGrid = document.getElementById("preview-grid");
	const publishButton = document.getElementById("publish-button");
	const publishStatus = document.getElementById("publish-status");

	let selectedFiles = [];

	imageInput?.addEventListener("change", () => {
		selectedFiles = Array.from(imageInput.files || []);
		renderPreview();
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!descriptionInput?.value.trim()) {
			setStatus("先写一点想法。", "error");
			descriptionInput?.focus();
			return;
		}

		if (selectedFiles.length === 0) {
			setStatus("至少添加一张图片。", "error");
			return;
		}

		setBusy(true);
		setStatus("正在发布...", "");

		try {
			const images = await Promise.all(selectedFiles.map(fileToPayload));
			const response = await fetch("/api/portfolio/publish", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({
					description: descriptionInput.value,
					images,
				}),
			});
			const payload = await response.json();

			if (response.status === 401) {
				window.location.href = "/api/github/login";
				return;
			}

			if (!response.ok || !payload.ok) {
				throw new Error(payload.message || "发布失败");
			}

			form.reset();
			selectedFiles = [];
			renderPreview();
			setStatus("发表成功，等待自动部署后就能在作品集看到。", "ok");
		} catch (error) {
			setStatus(error.message || "发布失败，请稍后再试。", "error");
		} finally {
			setBusy(false);
		}
	});

	function renderPreview() {
		if (!previewGrid) return;
		previewGrid.innerHTML = "";

		for (const file of selectedFiles.slice(0, 9)) {
			const tile = document.createElement("div");
			const image = document.createElement("img");

			tile.className = "preview-tile";
			image.src = URL.createObjectURL(file);
			image.alt = file.name;
			tile.appendChild(image);
			previewGrid.appendChild(tile);
		}

		const addTile = document.createElement("label");
		addTile.className = "add-tile";
		addTile.setAttribute("aria-label", "添加图片");
		addTile.innerHTML = '<input id="image-input-live" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple /><span>+</span>';
		previewGrid.appendChild(addTile);

		const liveInput = addTile.querySelector("input");
		liveInput?.addEventListener("change", () => {
			selectedFiles = Array.from(liveInput.files || []);
			renderPreview();
		});
	}

	function fileToPayload(file) {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onload = () => {
				resolve({
					name: file.name,
					type: file.type,
					content: reader.result,
				});
			};
			reader.onerror = () => reject(new Error("读取图片失败"));
			reader.readAsDataURL(file);
		});
	}

	function setBusy(value) {
		if (!publishButton) return;
		publishButton.disabled = value;
		publishButton.textContent = value ? "发表中" : "发表";
	}

	function setStatus(message, type) {
		if (!publishStatus) return;
		publishStatus.textContent = message;
		publishStatus.className = `status ${type}`;
	}
</script>

<style>
	.moment-shell {
		padding: 0;
		overflow: hidden;
		background: #fff;
	}

	.moment-form {
		min-height: 38rem;
		padding: 1.5rem 1.75rem 2rem;
		background: #fff;
	}

	.moment-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2.2rem;
	}

	.moment-topbar a {
		font-size: 1.08rem;
		color: rgb(0 0 0 / 88%);
	}

	.moment-topbar button {
		border-radius: 0.45rem;
		background: #07c160;
		color: white;
		font-size: 1rem;
		font-weight: 700;
		min-width: 4.2rem;
		height: 2.45rem;
		padding: 0 1rem;
		transition: opacity 0.2s ease;
	}

	.moment-topbar button:disabled {
		opacity: 0.65;
	}

	textarea {
		width: 100%;
		min-height: 8rem;
		border: 0;
		outline: 0;
		resize: vertical;
		padding: 0;
		background: transparent;
		color: rgb(0 0 0 / 90%);
		font-size: 1.2rem;
		line-height: 1.75;
	}

	textarea::placeholder {
		color: rgb(0 0 0 / 24%);
	}

	.preview-grid {
		margin-top: 1.6rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		max-width: 30rem;
	}

	.preview-tile,
	.add-tile {
		aspect-ratio: 1 / 1;
		background: #f5f5f5;
		overflow: hidden;
	}

	.preview-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.add-tile {
		display: grid;
		place-items: center;
		cursor: pointer;
	}

	.add-tile input {
		display: none;
	}

	.add-tile span {
		color: rgb(0 0 0 / 46%);
		font-size: 4rem;
		font-weight: 200;
		line-height: 1;
	}

	.status {
		margin: 1.2rem 0 0;
		line-height: 1.7;
		color: rgb(0 0 0 / 48%);
	}

	.status.ok {
		color: #07c160;
	}

	.status.error {
		color: #c2410c;
	}

	:global(.dark) .moment-shell,
	:global(.dark) .moment-form {
		background: #fff;
	}

	:global(.dark) .moment-topbar a,
	:global(.dark) textarea {
		color: rgb(0 0 0 / 90%);
	}

	@media (max-width: 640px) {
		.moment-shell {
			border-radius: 0;
		}

		.moment-form {
			min-height: calc(100vh - 5.5rem);
			padding: 1.25rem 1rem 2rem;
		}

		.preview-grid {
			max-width: none;
		}
	}
</style>
