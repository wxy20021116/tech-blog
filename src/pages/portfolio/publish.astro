---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---

<MainGridLayout title="发布作品" description="隐藏的作品墙发布页面">
	<meta slot="head" name="robots" content="noindex,nofollow" />

	<section class="moment-shell card-base">
		<div id="auth-panel" class="auth-panel">
			<a id="auth-button" class="auth-button" href="/api/github/login" data-no-swup>GitHub 授权</a>
			<input id="token-input" class="token-input" type="password" autocomplete="off" placeholder="或粘贴 GitHub token" />
			<button id="token-button" class="token-button" type="button">使用 Token</button>
			<p id="auth-status" class="status" aria-live="polite"></p>
		</div>

		<form id="publish-form" class="moment-form">
			<header class="moment-topbar">
				<a href="/portfolio/" aria-label="取消">取消</a>
				<button id="publish-button" type="submit">发表</button>
			</header>

			<textarea id="description-input" maxlength="500" rows="6" placeholder="这一刻的想法..."></textarea>

			<div id="preview-grid" class="preview-grid">
				<label class="add-tile" aria-label="添加图片">
					<input id="image-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
					<span>+</span>
				</label>
			</div>

			<p id="publish-status" class="status" aria-live="polite"></p>
		</form>
	</section>
</MainGridLayout>

<script>
	const form = document.getElementById("publish-form") as HTMLFormElement | null;
	const descriptionInput = document.getElementById(
		"description-input",
	) as HTMLTextAreaElement | null;
	const imageInput = document.getElementById(
		"image-input",
	) as HTMLInputElement | null;
	const previewGrid = document.getElementById("preview-grid");
	const publishButton = document.getElementById(
		"publish-button",
	) as HTMLButtonElement | null;
	const publishStatus = document.getElementById("publish-status");
	const authPanel = document.getElementById("auth-panel");
	const authButton = document.getElementById("auth-button");
	const authStatus = document.getElementById("auth-status");
	const tokenInput = document.getElementById("token-input") as HTMLInputElement | null;
	const tokenButton = document.getElementById("token-button") as HTMLButtonElement | null;

	const AUTH_TOKEN_KEY = "github_access_token";
	let selectedFiles: File[] = [];
	let authReady = false;

	initAuth();

	imageInput?.addEventListener("change", () => {
		selectedFiles = Array.from(imageInput.files || []);
		renderPreview();
	});

	tokenButton?.addEventListener("click", async () => {
		const token = tokenInput?.value.trim() || "";
		if (!token) {
			updateAuthState(false, "请先粘贴 GitHub token。", "error");
			tokenInput?.focus();
			return;
		}

		saveAuthToken(token);
		updateAuthState(false, "正在验证 GitHub token...", "");
		await initAuth();
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!authReady) {
			updateAuthState(false, "需要先完成 GitHub 授权。", "error");
			return;
		}

		if (!descriptionInput?.value.trim()) {
			setStatus("先写一点想法。", "error");
			descriptionInput?.focus();
			return;
		}

		if (selectedFiles.length === 0) {
			setStatus("至少添加一张图片。", "error");
			return;
		}

		setBusy(true);
		setStatus("正在发布...", "");

		try {
			const images = await Promise.all(selectedFiles.map(fileToPayload));
			const response = await fetch("/api/portfolio/publish", {
				method: "POST",
				headers: authHeaders({
					"Content-Type": "application/json",
				}),
				body: JSON.stringify({
					description: descriptionInput.value,
					images,
				}),
			});
			const payload = await readJson(response);

			if (response.status === 401) {
				authReady = false;
				updateAuthState(false, "授权已失效，请重新完成 GitHub 授权后再发表。", "error");
				return;
			}

			if (!response.ok || !payload.ok) {
				throw new Error(payload.message || "发布失败");
			}

			form.reset();
			selectedFiles = [];
			renderPreview();
			const commitLink = payload.url ? ` 提交：${payload.url}` : "";
			setStatus(`发表成功，等待自动部署后就能在作品集看到。${commitLink}`, "ok");
		} catch (error) {
			setStatus(errorMessage(error, "发布失败，请稍后再试。"), "error");
		} finally {
			setBusy(false);
		}
	});

	async function initAuth() {
		const authResult = getAuthResult();
		updateAuthState(false, authResult.message || "正在检查 GitHub 授权...", authResult.type);

		try {
			const response = await fetch("/api/github/me", {
				headers: authHeaders({ Accept: "application/json" }),
				cache: "no-store",
			});
			const payload = await readJson(response);

			if (!payload.authenticated) {
				authReady = false;
				clearAuthToken();
				const message =
					authResult.auth === "ok"
						? "GitHub 已返回授权，但登录状态没有保存成功，请重新点击 GitHub 授权。"
						: "需要先完成 GitHub 授权。";
				updateAuthState(false, message, authResult.auth === "ok" ? "error" : "");
				return;
			}

			if (!payload.allowed) {
				authReady = false;
				updateAuthState(false, `已登录 ${payload.login || "GitHub"}，但这个账号不在允许发布名单内。`, "error");
				return;
			}

			authReady = true;
			updateAuthState(true, `授权成功，当前账号：${payload.login || "GitHub"}。`, "ok");
		} catch (error) {
			authReady = false;
			updateAuthState(false, errorMessage(error, "授权状态检查失败，请稍后重试，或重新点击授权。"), "error");
		}
	}

	function authHeaders(headers: Record<string, string>) {
		const token = getAuthToken();
		return token
			? {
					...headers,
					Authorization: `Bearer ${token}`,
				}
			: headers;
	}

	function getAuthToken() {
		try {
			return sessionStorage.getItem(AUTH_TOKEN_KEY) || "";
		} catch {
			return "";
		}
	}

	function saveAuthToken(token: string) {
		try {
			sessionStorage.setItem(AUTH_TOKEN_KEY, token);
		} catch {
			updateAuthState(false, "浏览器无法保存 token，请检查隐私模式或站点存储权限。", "error");
		}
	}

	function clearAuthToken() {
		try {
			sessionStorage.removeItem(AUTH_TOKEN_KEY);
		} catch {
			// Ignore storage errors so the page can still fall back to cookie auth.
		}
	}

	function getAuthResult() {
		const auth = new URLSearchParams(window.location.search).get("auth");
		if (auth === "ok") {
			return {
				auth,
				message: "GitHub 已返回授权，正在确认账号...",
				type: "",
			};
		}
		if (auth === "failed") {
			return {
				auth,
				message: "授权失败，请重新点击 GitHub 授权。",
				type: "error",
			};
		}
		if (auth === "missing") {
			return {
				auth,
				message: "服务器还没有配置 GitHub OAuth。",
				type: "error",
			};
		}
		return { auth: "", message: "", type: "" };
	}

	function updateAuthState(ready: boolean, status: string, type: string) {
		authReady = ready;
		if (authPanel) authPanel.hidden = false;
		if (authStatus) {
			authStatus.textContent = status;
			authStatus.className = `status ${type}`;
		}
		if (authButton) authButton.textContent = ready ? "重新授权" : "GitHub 授权";
		if (tokenInput) {
			tokenInput.hidden = ready;
			tokenInput.disabled = false;
			if (ready) tokenInput.value = "";
		}
		if (tokenButton) {
			tokenButton.hidden = ready;
			tokenButton.disabled = false;
		}
		if (form) form.classList.toggle("is-disabled", !ready);
		if (descriptionInput) descriptionInput.disabled = !ready;
		if (imageInput) imageInput.disabled = !ready;
		if (publishButton) publishButton.disabled = !ready;
		for (const input of document.querySelectorAll<HTMLInputElement>(".add-tile input")) {
			input.disabled = !ready;
		}
	}

	async function readJson(response: Response) {
		const text = await response.text();
		if (!text) return {};

		try {
			return JSON.parse(text);
		} catch {
			throw new Error(response.ok ? "接口返回格式异常。" : "服务端返回异常，请稍后再试。");
		}
	}

	function errorMessage(error: unknown, fallback: string) {
		return error instanceof Error && error.message ? error.message : fallback;
	}

	function renderPreview() {
		if (!previewGrid) return;
		previewGrid.innerHTML = "";

		for (const file of selectedFiles.slice(0, 9)) {
			const tile = document.createElement("div");
			const image = document.createElement("img");

			tile.className = "preview-tile";
			image.src = URL.createObjectURL(file);
			image.alt = file.name;
			tile.appendChild(image);
			previewGrid.appendChild(tile);
		}

		const addTile = document.createElement("label");
		addTile.className = "add-tile";
		addTile.setAttribute("aria-label", "添加图片");
		addTile.innerHTML = '<input id="image-input-live" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple /><span>+</span>';
		previewGrid.appendChild(addTile);

		const liveInput = addTile.querySelector("input") as HTMLInputElement | null;
		if (liveInput) liveInput.disabled = !authReady;
		liveInput?.addEventListener("change", () => {
			selectedFiles = Array.from(liveInput.files || []);
			renderPreview();
		});
	}

	function fileToPayload(file: File) {
		return new Promise((resolve, reject) => {
			const reader = new FileReader();
			reader.onload = () => {
				resolve({
					name: file.name,
					type: file.type,
					content: reader.result,
				});
			};
			reader.onerror = () => reject(new Error("读取图片失败"));
			reader.readAsDataURL(file);
		});
	}

	function setBusy(value: boolean) {
		if (!publishButton) return;
		publishButton.disabled = value || !authReady;
		publishButton.textContent = value ? "发表中" : "发表";
	}

	function setStatus(message: string, type: string) {
		if (!publishStatus) return;
		publishStatus.textContent = message;
		publishStatus.className = `status ${type}`;
	}
</script>

<style>
	.moment-shell {
		padding: 0;
		overflow: hidden;
		background: #fff;
	}

	.moment-form {
		min-height: 38rem;
		padding: 1.25rem 1.75rem 2rem;
		background: #fff;
	}

	.auth-panel {
		padding: 1.25rem 1.75rem 0;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		background: #fff;
	}

	.auth-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.45rem;
		background: #24292f;
		color: white;
		font-size: 1rem;
		font-weight: 700;
		min-height: 2.6rem;
		padding: 0 1.1rem;
	}

	.token-input {
		width: min(17rem, 32vw);
		min-height: 2.6rem;
		border: 1px solid rgb(0 0 0 / 14%);
		border-radius: 0.45rem;
		padding: 0 0.8rem;
		color: rgb(0 0 0 / 84%);
		background: #fff;
	}

	.token-button {
		min-height: 2.6rem;
		border-radius: 0.45rem;
		background: #f3f4f6;
		color: rgb(0 0 0 / 82%);
		font-weight: 700;
		padding: 0 0.9rem;
	}

	.moment-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.6rem;
	}

	.moment-topbar a {
		font-size: 1.08rem;
		color: rgb(0 0 0 / 88%);
	}

	.moment-topbar button {
		border-radius: 0.45rem;
		background: #07c160;
		color: white;
		font-size: 1rem;
		font-weight: 700;
		min-width: 4.2rem;
		height: 2.45rem;
		padding: 0 1rem;
		transition: opacity 0.2s ease;
	}

	.moment-topbar button:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	textarea {
		width: 100%;
		min-height: 8rem;
		border: 0;
		outline: 0;
		resize: vertical;
		padding: 0;
		background: transparent;
		color: rgb(0 0 0 / 90%);
		font-size: 1.2rem;
		line-height: 1.75;
	}

	textarea::placeholder {
		color: rgb(0 0 0 / 24%);
	}

	textarea:disabled {
		cursor: not-allowed;
		color: rgb(0 0 0 / 45%);
	}

	.preview-grid {
		margin-top: 1.6rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		max-width: 30rem;
	}

	.preview-tile,
	.add-tile {
		aspect-ratio: 1 / 1;
		background: #f5f5f5;
		overflow: hidden;
	}

	.preview-tile img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.add-tile {
		display: grid;
		place-items: center;
		cursor: pointer;
	}

	.moment-form.is-disabled .add-tile {
		cursor: not-allowed;
		opacity: 0.58;
	}

	.add-tile input {
		display: none;
	}

	.add-tile span {
		color: rgb(0 0 0 / 46%);
		font-size: 4rem;
		font-weight: 200;
		line-height: 1;
	}

	.status {
		margin: 1.2rem 0 0;
		line-height: 1.7;
		color: rgb(0 0 0 / 48%);
	}

	.auth-panel .status {
		margin: 0;
	}

	.status.ok {
		color: #07c160;
	}

	.status.error {
		color: #c2410c;
	}

	:global(.dark) .moment-shell,
	:global(.dark) .moment-form,
	:global(.dark) .auth-panel {
		background: #fff;
	}

	:global(.dark) .moment-topbar a,
	:global(.dark) textarea,
	:global(.dark) .auth-title {
		color: rgb(0 0 0 / 90%);
	}

	@media (max-width: 640px) {
		.moment-shell {
			border-radius: 0;
		}

		.auth-panel {
			align-items: stretch;
			flex-direction: column;
		}

		.token-input {
			width: 100%;
		}

		.moment-form {
			min-height: calc(100vh - 5.5rem);
			padding: 1.25rem 1rem 2rem;
		}

		.preview-grid {
			max-width: none;
		}
	}
</style>
