---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "图片文字识别工具";
const description =
	"在线图片 OCR 文字识别工具，支持上传图片后在浏览器本地识别中英文文字，可直接在图片上拖选复制，也可复制识别出的全部文字和分行结果。";
const keywords = [
	"图片文字识别",
	"OCR 识别",
	"图片转文字",
	"截图文字复制",
	"在线 OCR",
	"图片文字复制",
];
const pageUrl = new URL(
	"/tools/image-ocr/",
	Astro.site || Astro.url.origin,
).toString();
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: title,
		description,
		url: pageUrl,
		applicationCategory: "UtilitiesApplication",
		operatingSystem: "Any",
		inLanguage: "zh-CN",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "CNY",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "图片文字识别会上传到服务器吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。当前工具使用 Tesseract.js 在浏览器本地运行 OCR，图片和识别结果只保留在当前浏览器页面中。",
				},
			},
			{
				"@type": "Question",
				name: "为什么第一次识别比较慢？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "第一次识别需要加载 OCR 引擎和语言模型，浏览器缓存后再次使用通常会更快。图片越大、文字越多，识别耗时也越长。",
				},
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "工具",
				item: new URL("/tools/", Astro.site || Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title,
				item: pageUrl,
			},
		],
	},
];
---

<MainGridLayout title={title} description={description} keywords={keywords}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<section class="card-base px-6 py-7 md:px-9 md:py-8">
		<a href="/tools/" class="link-lg inline-flex items-center text-sm font-medium text-50">
			<Icon name="material-symbols:arrow-back-rounded" class="mr-1 text-[1.2rem]" />
			工具箱
		</a>
		<div class="mt-4 max-w-3xl">
			<p class="text-sm font-semibold text-[var(--primary)]">Image OCR</p>
			<h1 class="mt-2 text-2xl font-bold text-90 md:text-3xl">{title}</h1>
			<p class="mt-3 leading-7 text-75">
				上传截图、照片或文档图片后，在浏览器本地识别文字。识别完成后可以直接在图片预览上拖选复制，也可以在下方复制全部文本、分行文本和单个词句。
			</p>
		</div>
	</section>

	<image-ocr-tool class="card-base mt-4 block overflow-hidden">
		<section class="border-b border-[var(--line-divider)] p-4 md:p-5">
			<div class="grid gap-4 lg:grid-cols-[1fr_18rem]">
				<label class="flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed border-black/15 bg-[var(--page-bg)] px-4 py-6 text-center transition hover:border-[var(--primary)] dark:border-white/15">
					<Icon name="material-symbols:image-search-rounded" class="text-[2.2rem] text-[var(--primary)]" />
					<span class="mt-2 font-bold text-90">选择图片</span>
					<span class="mt-1 text-sm text-50">支持 JPG、PNG、WebP、截图等浏览器可读取图片</span>
					<input data-file class="hidden" type="file" accept="image/*" />
				</label>

				<div class="grid content-start gap-3">
					<label class="grid gap-2 text-sm font-medium text-75">
						识别语言
						<select data-language class="h-10 rounded-lg border border-black/10 bg-[var(--page-bg)] px-3 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10">
							<option value="chi_sim+eng">简体中文 + 英文</option>
							<option value="eng">英文</option>
							<option value="chi_tra+eng">繁体中文 + 英文</option>
						</select>
					</label>
					<div class="grid gap-2">
						<button type="button" data-action="recognize" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">开始识别</button>
						<button type="button" data-action="copy-all" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">复制全部文字</button>
						<button type="button" data-action="clear" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">清空</button>
					</div>
					<label class="flex items-center gap-2 text-sm font-medium text-75">
						<input data-show-layer type="checkbox" class="h-4 w-4 accent-[var(--primary)]" />
						显示文字选区边框
					</label>
					<div class="rounded-lg bg-[var(--page-bg)] p-3 text-sm leading-6 text-50">
						<p>首次识别会加载 OCR 模型，稍等一下就好。</p>
						<p>清晰截图、黑白文档和大字号图片识别更稳定。</p>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-[var(--card-bg)] p-4 md:p-5">
			<h2 class="mb-3 text-base font-bold text-90">图片预览与可复制文字层</h2>
			<div data-preview-wrap class="flex min-h-80 items-center justify-center overflow-auto rounded-lg border border-black/10 bg-[var(--page-bg)] p-3 dark:border-white/10">
				<div data-image-stage class="relative hidden max-w-full">
					<img data-preview class="block max-h-[42rem] max-w-full select-none object-contain" alt="待识别图片预览" />
					<div data-text-layer class="absolute inset-0 z-10 select-text"></div>
				</div>
				<p data-empty class="px-4 text-center text-sm text-50">请选择一张包含文字的图片。</p>
			</div>
			<div class="mt-3 grid gap-2 rounded-lg bg-[var(--page-bg)] p-4 text-sm text-75 md:grid-cols-3">
				<p>文件名：<span data-file-name class="font-mono text-90">--</span></p>
				<p>尺寸：<span data-image-size class="font-mono text-90">--</span></p>
				<p>识别置信度：<span data-confidence class="font-mono text-90">--</span></p>
			</div>
		</section>

		<section class="grid gap-px bg-[var(--line-divider)] lg:grid-cols-[1fr_22rem]">
			<div class="bg-[var(--card-bg)] p-4 md:p-5">
				<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
					<h2 class="text-base font-bold text-90">全部文字</h2>
					<button type="button" data-action="copy-all" class="btn-regular h-8 rounded-lg px-3 text-sm font-medium">复制</button>
				</div>
				<textarea data-output class="min-h-64 w-full resize-y rounded-lg border border-black/10 bg-[var(--page-bg)] p-3 text-sm leading-7 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10" placeholder="识别结果会显示在这里"></textarea>
			</div>

			<div class="bg-[var(--card-bg)] p-4 md:p-5">
				<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
					<h2 class="text-base font-bold text-90">分行词句</h2>
					<span data-line-count class="text-sm text-50">0 条</span>
				</div>
				<div data-lines class="grid max-h-80 gap-2 overflow-auto pr-1">
					<p class="rounded-lg bg-[var(--page-bg)] p-3 text-sm text-50">识别后可逐条复制。</p>
				</div>
			</div>
		</section>

		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line-divider)] px-4 py-3 md:px-5">
			<p data-status class="text-sm text-50">等待选择图片</p>
			<p class="text-sm text-50">浏览器本地识别，不上传服务器</p>
		</div>
	</image-ocr-tool>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">常见问题</h2>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div>
				<h3 class="font-bold text-90">没有后端也能做 OCR 吗？</h3>
				<p class="mt-2 leading-7 text-75">
					可以。这个工具使用 Tesseract.js，把 OCR 引擎放在浏览器里运行。图片不会上传到服务器，适合个人截图、文档图片和临时识别。
				</p>
			</div>
			<div>
				<h3 class="font-bold text-90">图片上拖选复制为什么有时会偏？</h3>
				<p class="mt-2 leading-7 text-75">
					覆盖层位置来自 OCR 返回的文字坐标，低清、旋转、透视变形或花背景会影响定位。遇到这种情况，可以直接复制下方的全部文字或分行结果。
				</p>
			</div>
		</div>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">相关工具</h2>
		<div class="mt-3 flex flex-wrap gap-2">
			<a href="/tools/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">在线工具箱</a>
			<a href="/tools/image-compress/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">图片压缩</a>
			<a href="/tools/image-restore/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">图片局部还原</a>
		</div>
	</section>
</MainGridLayout>
