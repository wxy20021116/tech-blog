---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "图片局部还原工具";
const description =
	"在线图片局部还原工具，支持在浏览器本地涂抹水印、时间戳、遮挡文字或局部瑕疵区域，并使用传统图像修复算法尽量还原图片内容。";
const keywords = [
	"图片局部还原",
	"图片水印区域修复",
	"图片瑕疵修复",
	"在线图片修复",
	"图片遮挡清理",
	"OpenCV 图片修复",
];
const pageUrl = new URL(
	"/tools/image-restore/",
	Astro.site || Astro.url.origin,
).toString();
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: title,
		description,
		url: pageUrl,
		applicationCategory: "MultimediaApplication",
		operatingSystem: "Any",
		inLanguage: "zh-CN",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "CNY",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "图片会上传到服务器吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。图片读取、涂抹区域和修复结果都在浏览器本地完成。",
				},
			},
			{
				"@type": "Question",
				name: "这个工具可以还原所有图片细节吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不能。当前工具使用传统图像修复算法，适合小面积文字、时间戳、标记和简单背景；复杂纹理、人脸五官或大面积遮挡可能会有痕迹。",
				},
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "工具",
				item: new URL("/tools/", Astro.site || Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title,
				item: pageUrl,
			},
		],
	},
];
---

<MainGridLayout title={title} description={description} keywords={keywords}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<section class="card-base px-6 py-7 md:px-9 md:py-8">
		<a href="/tools/" class="link-lg inline-flex items-center text-sm font-medium text-50">
			<Icon name="material-symbols:arrow-back-rounded" class="mr-1 text-[1.2rem]" />
			工具箱
		</a>
		<div class="mt-4 max-w-3xl">
			<p class="text-sm font-semibold text-[var(--primary)]">Image Restore</p>
			<h1 class="mt-2 text-2xl font-bold text-90 md:text-3xl">{title}</h1>
			<p class="mt-3 leading-7 text-75">
				上传图片后涂抹需要还原的区域，浏览器会在本地用图像修复算法填补内容，适合处理误加标记、时间戳、遮挡文字和小面积水印区域。
			</p>
		</div>
	</section>

	<image-restore-tool class="card-base mt-4 block overflow-hidden">
		<section class="border-b border-[var(--line-divider)] p-4 md:p-5">
			<div class="grid gap-4 xl:grid-cols-[1fr_18rem]">
				<label class="flex min-h-36 cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed border-black/15 bg-[var(--page-bg)] px-4 py-6 text-center transition hover:border-[var(--primary)] dark:border-white/15">
					<Icon name="material-symbols:add-photo-alternate-outline-rounded" class="text-[2.2rem] text-[var(--primary)]" />
					<span class="mt-2 font-bold text-90">选择图片</span>
					<span class="mt-1 text-sm text-50">支持 JPG、PNG、WebP 等浏览器可读取图片</span>
					<input data-file class="hidden" type="file" accept="image/*" />
				</label>

				<div class="grid gap-3">
					<label class="grid gap-2 text-sm font-medium text-75">
						笔刷大小 <span data-brush-label class="text-50">28px</span>
						<input data-brush type="range" min="8" max="96" value="28" class="accent-[var(--primary)]" />
					</label>
					<label class="grid gap-2 text-sm font-medium text-75">
						修复半径 <span data-radius-label class="text-50">3</span>
						<input data-radius type="range" min="1" max="12" value="3" class="accent-[var(--primary)]" />
					</label>
					<label class="grid gap-2 text-sm font-medium text-75">
						算法
						<select data-algorithm class="h-10 rounded-lg border border-black/10 bg-[var(--page-bg)] px-3 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10">
							<option value="telea">快速还原</option>
							<option value="ns">平滑还原</option>
						</select>
					</label>
					<div class="flex flex-wrap gap-2">
						<button type="button" data-action="restore" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">还原</button>
						<button type="button" data-action="clear-mask" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">清除涂抹</button>
						<button type="button" data-action="clear" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">清空</button>
					</div>
				</div>
			</div>
		</section>

		<div class="grid gap-px bg-[var(--line-divider)] xl:grid-cols-2">
			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<h2 class="mb-3 text-base font-bold text-90">涂抹区域</h2>
				<div class="flex min-h-80 items-center justify-center overflow-auto rounded-lg border border-black/10 bg-[var(--page-bg)] p-3 dark:border-white/10">
					<p data-empty class="px-4 text-center text-sm text-50">请选择一张图片，然后在图片上涂抹需要还原的区域。</p>
					<div data-canvas-wrap class="relative hidden max-h-[34rem] max-w-full touch-none select-none">
						<canvas data-original-canvas class="block max-h-[34rem] max-w-full rounded-md object-contain"></canvas>
						<canvas data-mask-canvas class="absolute inset-0 block h-full w-full cursor-crosshair rounded-md"></canvas>
					</div>
				</div>
				<div class="mt-3 grid gap-2 rounded-lg bg-[var(--page-bg)] p-4 text-sm text-75">
					<p>文件名：<span data-original-name class="font-mono text-90">--</span></p>
					<p>尺寸：<span data-original-size class="font-mono text-90">--</span></p>
					<p>体积：<span data-original-bytes class="font-mono text-90">--</span></p>
				</div>
			</section>

			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<h2 class="mb-3 text-base font-bold text-90">还原结果</h2>
				<div class="flex min-h-80 items-center justify-center overflow-auto rounded-lg border border-black/10 bg-[var(--page-bg)] p-3 dark:border-white/10">
					<p data-output-empty class="px-4 text-center text-sm text-50">涂抹后点击还原，结果会显示在这里。</p>
					<canvas data-output-canvas class="hidden max-h-[34rem] max-w-full cursor-zoom-in rounded-md object-contain"></canvas>
				</div>
				<div class="mt-3 grid gap-2 rounded-lg bg-[var(--page-bg)] p-4 text-sm text-75">
					<p>输出格式：<span class="font-mono text-90">PNG</span></p>
					<p>输出尺寸：<span data-output-size class="font-mono text-90">--</span></p>
				</div>
				<div class="mt-3 flex flex-wrap gap-2">
					<a data-download class="btn-regular pointer-events-none h-9 rounded-lg px-3 text-sm font-medium opacity-50" href="#" download>下载结果</a>
				</div>
			</section>
		</div>

		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line-divider)] px-4 py-3 md:px-5">
			<p data-status class="text-sm text-50">等待选择图片</p>
			<p class="text-sm text-50">本地处理，不上传服务器</p>
		</div>
	</image-restore-tool>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">使用条款</h2>
		<p class="mt-3 leading-7 text-75">
			本工具用于还原用户拥有处理权的图片，例如误加标记、时间戳、遮挡文字或局部瑕疵。图片处理过程在浏览器本地完成，不会上传服务器。用户应确保上传和处理的图片具备合法使用权，因使用本工具产生的版权、肖像权、平台规则或其他法律责任由用户自行承担。继续使用即表示同意以上条款。
		</p>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">常见问题</h2>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div>
				<h3 class="font-bold text-90">为什么有些区域还原后会发糊？</h3>
				<p class="mt-2 leading-7 text-75">
					传统图像修复会根据周围像素推断填补内容，小面积文字和简单背景效果较好；复杂纹理、人物细节或大面积遮挡会更容易留下痕迹。
				</p>
			</div>
			<div>
				<h3 class="font-bold text-90">怎样提高还原效果？</h3>
				<p class="mt-2 leading-7 text-75">
					只涂抹需要处理的区域，边缘略微覆盖水印即可。若结果不理想，可以调整修复半径，或切换快速还原和平滑还原后再试。
				</p>
			</div>
		</div>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">相关工具</h2>
		<div class="mt-3 flex flex-wrap gap-2">
			<a href="/tools/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">在线工具箱</a>
			<a href="/tools/image-compress/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">图片压缩</a>
			<a href="/tools/base64/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">Base64 编码解码</a>
		</div>
	</section>
</MainGridLayout>
