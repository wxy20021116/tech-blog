---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "图片压缩工具";
const description =
	"在线图片压缩工具，支持在浏览器本地压缩 JPG、PNG 图片，并可转换为 WebP 格式，支持质量调节、最大宽高限制、预览和下载。";
const keywords = [
	"图片压缩",
	"在线图片压缩",
	"图片转 WebP",
	"WebP 压缩",
	"JPG 压缩",
	"PNG 压缩",
];
const pageUrl = new URL(
	"/tools/image-compress/",
	Astro.site || Astro.url.origin,
).toString();
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: title,
		description,
		url: pageUrl,
		applicationCategory: "MultimediaApplication",
		operatingSystem: "Any",
		inLanguage: "zh-CN",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "CNY",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "图片压缩会上传到服务器吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。当前工具使用浏览器 Canvas 在本地压缩和转换图片。",
				},
			},
			{
				"@type": "Question",
				name: "可以把图片压缩成 WebP 格式吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "可以。选择输出格式为 WebP 后，工具会在浏览器内重新编码为 WebP 图片。",
				},
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "工具",
				item: new URL("/tools/", Astro.site || Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title,
				item: pageUrl,
			},
		],
	},
];
---

<MainGridLayout title={title} description={description} keywords={keywords}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<section class="card-base px-6 py-7 md:px-9 md:py-8">
		<a href="/tools/" class="link-lg inline-flex items-center text-sm font-medium text-50">
			<Icon name="material-symbols:arrow-back-rounded" class="mr-1 text-[1.2rem]" />
			工具箱
		</a>
		<div class="mt-4 max-w-3xl">
			<p class="text-sm font-semibold text-[var(--primary)]">Image Compressor</p>
			<h1 class="mt-2 text-2xl font-bold text-90 md:text-3xl">{title}</h1>
			<p class="mt-3 leading-7 text-75">
				在线压缩图片体积，并可转换为 WebP 格式。图片在浏览器本地处理，不上传服务器，适合博客封面、网页配图和上传前压缩。
			</p>
		</div>
	</section>

	<image-compress-tool class="card-base mt-4 block overflow-hidden">
		<section class="border-b border-[var(--line-divider)] p-4 md:p-5">
			<div class="grid gap-4 lg:grid-cols-[1fr_18rem]">
				<label class="flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed border-black/15 bg-[var(--page-bg)] px-4 py-6 text-center transition hover:border-[var(--primary)] dark:border-white/15">
					<Icon name="material-symbols:add-photo-alternate-outline-rounded" class="text-[2.2rem] text-[var(--primary)]" />
					<span class="mt-2 font-bold text-90">选择图片</span>
					<span class="mt-1 text-sm text-50">支持 JPG、PNG、WebP 等浏览器可读取图片</span>
					<input data-file class="hidden" type="file" accept="image/*" />
				</label>

				<div class="grid gap-3">
					<label class="grid gap-2 text-sm font-medium text-75">
						输出格式
						<select data-format class="h-10 rounded-lg border border-black/10 bg-[var(--page-bg)] px-3 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10">
							<option value="image/webp">WebP</option>
							<option value="image/jpeg">JPEG</option>
							<option value="image/png">PNG</option>
						</select>
					</label>
					<label class="grid gap-2 text-sm font-medium text-75">
						质量 <span data-quality-label class="text-50">80%</span>
						<input data-quality type="range" min="10" max="100" value="80" class="accent-[var(--primary)]" />
					</label>
					<label class="grid gap-2 text-sm font-medium text-75">
						最大宽高
						<input data-max-size type="number" min="64" max="10000" step="1" value="1920" class="h-10 rounded-lg border border-black/10 bg-[var(--page-bg)] px-3 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10" />
					</label>
					<div class="flex flex-wrap gap-2">
						<button type="button" data-action="compress" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">压缩</button>
						<a data-download class="btn-regular pointer-events-none h-9 rounded-lg px-3 text-sm font-medium opacity-50" href="#" download>下载</a>
						<button type="button" data-action="clear" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">清空</button>
					</div>
				</div>
			</div>
		</section>

		<div class="grid gap-px bg-[var(--line-divider)] lg:grid-cols-2">
			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<h2 class="mb-3 text-base font-bold text-90">原图</h2>
				<div class="flex min-h-72 items-center justify-center overflow-hidden rounded-lg border border-black/10 bg-[var(--page-bg)] dark:border-white/10">
					<img data-original-preview class="hidden max-h-[28rem] max-w-full object-contain" alt="原图预览" />
					<p data-original-empty class="px-4 text-center text-sm text-50">请选择一张图片。</p>
				</div>
				<div class="mt-3 grid gap-2 rounded-lg bg-[var(--page-bg)] p-4 text-sm text-75">
					<p>文件名：<span data-original-name class="font-mono text-90">--</span></p>
					<p>尺寸：<span data-original-size class="font-mono text-90">--</span></p>
					<p>体积：<span data-original-bytes class="font-mono text-90">--</span></p>
				</div>
			</section>

			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<h2 class="mb-3 text-base font-bold text-90">压缩结果</h2>
				<div class="flex min-h-72 items-center justify-center overflow-hidden rounded-lg border border-black/10 bg-[var(--page-bg)] dark:border-white/10">
					<img data-output-preview class="hidden max-h-[28rem] max-w-full object-contain" alt="压缩结果预览" />
					<p data-output-empty class="px-4 text-center text-sm text-50">压缩后将在这里显示结果。</p>
				</div>
				<div class="mt-3 grid gap-2 rounded-lg bg-[var(--page-bg)] p-4 text-sm text-75">
					<p>输出格式：<span data-output-format class="font-mono text-90">--</span></p>
					<p>尺寸：<span data-output-size class="font-mono text-90">--</span></p>
					<p>体积：<span data-output-bytes class="font-mono text-90">--</span></p>
					<p>节省：<span data-saved-bytes class="font-mono text-90">--</span></p>
				</div>
			</section>
		</div>

		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line-divider)] px-4 py-3 md:px-5">
			<p data-status class="text-sm text-50">等待选择图片</p>
			<p class="text-sm text-50">本地压缩，不上传服务器</p>
		</div>
	</image-compress-tool>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">常见问题</h2>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div>
				<h3 class="font-bold text-90">为什么 WebP 通常更小？</h3>
				<p class="mt-2 leading-7 text-75">
					WebP 是面向网页优化的图片格式，在相近画质下通常比 JPEG 和 PNG 更省体积，适合网站配图和封面图。
				</p>
			</div>
			<div>
				<h3 class="font-bold text-90">压缩会影响清晰度吗？</h3>
				<p class="mt-2 leading-7 text-75">
					会。质量越低、最大宽高越小，体积通常越小，但细节也会减少。建议从 75% 到 85% 之间开始尝试。
				</p>
			</div>
		</div>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">相关工具</h2>
		<div class="mt-3 flex flex-wrap gap-2">
			<a href="/tools/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">在线工具箱</a>
			<a href="/tools/base64/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">Base64 编码解码</a>
			<a href="/tools/markdown-to-html/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">Markdown 转 HTML</a>
		</div>
	</section>
</MainGridLayout>
