---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "正则表达式测试器";
const description =
	"在线正则表达式测试器，支持 JavaScript 正则、flags 设置、匹配高亮、捕获组查看、索引范围展示和示例文本。";
const keywords = [
	"正则表达式测试",
	"正则测试器",
	"在线正则",
	"JavaScript 正则",
	"Regex Tester",
	"正则匹配",
];
const pageUrl = new URL(
	"/tools/regex-tester/",
	Astro.site || Astro.url.origin,
).toString();
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: title,
		description,
		url: pageUrl,
		applicationCategory: "DeveloperApplication",
		operatingSystem: "Any",
		inLanguage: "zh-CN",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "CNY",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "这个正则测试器使用什么规则？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "当前工具使用浏览器内置的 JavaScript RegExp 规则，适合测试前端和 Node.js 中使用的正则表达式。",
				},
			},
			{
				"@type": "Question",
				name: "测试内容会上传到服务器吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。正则表达式和测试文本都在浏览器本地处理。",
				},
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "工具",
				item: new URL("/tools/", Astro.site || Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title,
				item: pageUrl,
			},
		],
	},
];
---

<MainGridLayout title={title} description={description} keywords={keywords}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<section class="card-base px-6 py-7 md:px-9 md:py-8">
		<a href="/tools/" class="link-lg inline-flex items-center text-sm font-medium text-50">
			<Icon name="material-symbols:arrow-back-rounded" class="mr-1 text-[1.2rem]" />
			工具箱
		</a>
		<div class="mt-4 max-w-3xl">
			<p class="text-sm font-semibold text-[var(--primary)]">Regex Tester</p>
			<h1 class="mt-2 text-2xl font-bold text-90 md:text-3xl">{title}</h1>
			<p class="mt-3 leading-7 text-75">
				在线测试 JavaScript 正则表达式，快速查看匹配结果、捕获组、索引位置和高亮预览。工具在浏览器本地运行，适合调试表单校验、日志提取和文本清洗规则。
			</p>
		</div>
	</section>

	<regex-tester-tool class="card-base mt-4 block overflow-hidden">
		<section class="border-b border-[var(--line-divider)] p-4 md:p-5">
			<div class="grid gap-4 lg:grid-cols-[1fr_auto]">
				<div>
					<label class="text-sm font-medium text-75" for="regex-pattern">正则表达式</label>
					<div class="mt-2 flex overflow-hidden rounded-lg border border-black/10 bg-[var(--page-bg)] font-mono text-sm text-90 transition focus-within:border-[var(--primary)] dark:border-white/10">
						<span class="flex h-11 items-center border-r border-black/10 px-3 text-50 dark:border-white/10">/</span>
						<input
							id="regex-pattern"
							data-pattern
							spellcheck="false"
							placeholder="例如：(?<name>[\\u4e00-\\u9fa5A-Za-z]+)\\s+(?<phone>1\\d{10})"
							class="h-11 min-w-0 flex-1 bg-transparent px-3 outline-none"
						/>
						<span class="flex h-11 items-center border-l border-black/10 px-3 text-50 dark:border-white/10">/</span>
					</div>
				</div>
				<div>
					<p class="text-sm font-medium text-75">Flags</p>
					<div class="mt-2 flex flex-wrap gap-2">
						{["g", "i", "m", "s", "u", "y"].map((flag) => (
							<label class="flex h-11 cursor-pointer select-none items-center gap-2 rounded-lg bg-[var(--page-bg)] px-3 text-sm font-medium text-75">
								<input data-flag={flag} class="h-4 w-4 accent-[var(--primary)]" type="checkbox" checked={flag === "g" || flag === "u"} />
								{flag}
							</label>
						))}
					</div>
				</div>
			</div>
			<div class="mt-4 flex flex-wrap gap-2">
				<button type="button" data-action="test" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">测试</button>
				<button type="button" data-action="sample" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">示例</button>
				<button type="button" data-action="copy" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">复制结果</button>
				<button type="button" data-action="clear" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">清空</button>
			</div>
		</section>

		<div class="grid gap-px bg-[var(--line-divider)] lg:grid-cols-2">
			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<div class="mb-3 flex items-center justify-between gap-3">
					<h2 class="text-base font-bold text-90">测试文本</h2>
					<p data-count class="text-sm text-50">0 个匹配</p>
				</div>
				<textarea
					data-text
					spellcheck="false"
					placeholder="输入要测试的文本"
					class="h-[28rem] w-full resize-y rounded-lg border border-black/10 bg-[var(--page-bg)] p-4 font-mono text-sm leading-6 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10"
				></textarea>
			</section>

			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<h2 class="mb-3 text-base font-bold text-90">匹配结果</h2>
				<div data-results class="h-[28rem] overflow-auto rounded-lg border border-black/10 bg-[var(--page-bg)] p-4 text-sm leading-6 text-75 dark:border-white/10">
					<p class="text-50">测试后将在这里显示匹配结果。</p>
				</div>
			</section>
		</div>

		<section class="border-t border-[var(--line-divider)] p-4 md:p-5">
			<div class="mb-3 flex items-center justify-between gap-3">
				<h2 class="text-base font-bold text-90">高亮预览</h2>
				<p class="text-sm text-50">黄色块为匹配片段</p>
			</div>
			<pre data-highlight class="min-h-40 whitespace-pre-wrap break-words rounded-lg border border-black/10 bg-[var(--page-bg)] p-4 font-mono text-sm leading-6 text-90 dark:border-white/10">测试后将在这里显示高亮预览。</pre>
		</section>

		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line-divider)] px-4 py-3 md:px-5">
			<p data-status class="text-sm text-50">等待输入正则表达式和测试文本</p>
			<p class="text-sm text-50">本地测试，不上传服务器</p>
		</div>
	</regex-tester-tool>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">常见问题</h2>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div>
				<h3 class="font-bold text-90">为什么默认勾选 g 和 u？</h3>
				<p class="mt-2 leading-7 text-75">
					<code>g</code> 用来查找全部匹配，<code>u</code> 对 Unicode 文本更友好，适合中文和 emoji 等内容。
				</p>
			</div>
			<div>
				<h3 class="font-bold text-90">支持命名捕获组吗？</h3>
				<p class="mt-2 leading-7 text-75">
					支持。浏览器支持的命名捕获组会显示在每条匹配结果里。
				</p>
			</div>
		</div>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">相关工具</h2>
		<div class="mt-3 flex flex-wrap gap-2">
			<a href="/tools/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">在线工具箱</a>
			<a href="/tools/json-format/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">JSON 格式化</a>
			<a href="/tools/base64/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">Base64 编码解码</a>
		</div>
	</section>
</MainGridLayout>
