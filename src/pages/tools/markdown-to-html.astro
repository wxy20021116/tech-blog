---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const title = "Markdown 转 HTML 工具";
const description =
	"在线 Markdown 转 HTML 工具，支持标题、列表、表格、代码块、链接等 Markdown 语法转换，并提供 HTML 源码复制和安全预览。";
const keywords = [
	"Markdown 转 HTML",
	"Markdown 在线转换",
	"Markdown 预览",
	"HTML 生成",
	"Markdown 工具",
	"Markdown 表格转换",
];
const pageUrl = new URL(
	"/tools/markdown-to-html/",
	Astro.site || Astro.url.origin,
).toString();
const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		name: title,
		description,
		url: pageUrl,
		applicationCategory: "DeveloperApplication",
		operatingSystem: "Any",
		inLanguage: "zh-CN",
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "CNY",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "Markdown 转 HTML 会上传内容吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。当前工具在浏览器本地完成 Markdown 转 HTML。",
				},
			},
			{
				"@type": "Question",
				name: "预览区会执行脚本吗？",
				acceptedAnswer: {
					"@type": "Answer",
					text: "不会。预览区会过滤脚本等危险内容，仅用于查看转换后的展示效果。",
				},
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "工具",
				item: new URL("/tools/", Astro.site || Astro.url.origin).toString(),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: title,
				item: pageUrl,
			},
		],
	},
];
---

<MainGridLayout title={title} description={description} keywords={keywords}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
	<section class="card-base px-6 py-7 md:px-9 md:py-8">
		<a href="/tools/" class="link-lg inline-flex items-center text-sm font-medium text-50">
			<Icon name="material-symbols:arrow-back-rounded" class="mr-1 text-[1.2rem]" />
			工具箱
		</a>
		<div class="mt-4 max-w-3xl">
			<p class="text-sm font-semibold text-[var(--primary)]">Markdown to HTML</p>
			<h1 class="mt-2 text-2xl font-bold text-90 md:text-3xl">{title}</h1>
			<p class="mt-3 leading-7 text-75">
				在线将 Markdown 转换成 HTML，支持常见标题、列表、表格、代码块和链接语法。转换在浏览器本地完成，适合写作、接口文档和富文本片段整理。
			</p>
		</div>
	</section>

	<markdown-html-tool class="card-base mt-4 block overflow-hidden">
		<div class="grid gap-px bg-[var(--line-divider)] lg:grid-cols-2">
			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
					<h2 class="text-base font-bold text-90">输入 Markdown</h2>
					<button type="button" data-action="sample" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">
						示例
					</button>
				</div>
				<textarea
					data-input
					spellcheck="false"
					placeholder="输入 Markdown 内容"
					class="h-[26rem] w-full resize-y rounded-lg border border-black/10 bg-[var(--page-bg)] p-4 font-mono text-sm leading-6 text-90 outline-none transition focus:border-[var(--primary)] dark:border-white/10"
				></textarea>
			</section>

			<section class="bg-[var(--card-bg)] p-4 md:p-5">
				<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
					<h2 class="text-base font-bold text-90">HTML 源码</h2>
					<div class="flex flex-wrap gap-2">
						<button type="button" data-action="convert" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">
							转换
						</button>
						<button type="button" data-action="copy" class="btn-regular h-9 rounded-lg px-3 text-sm font-medium">
							复制
						</button>
						<button type="button" data-action="clear" class="btn-plain h-9 rounded-lg px-3 text-sm font-medium">
							清空
						</button>
					</div>
				</div>
				<textarea
					data-output
					spellcheck="false"
					readonly
					class="h-[26rem] w-full resize-y rounded-lg border border-black/10 bg-[var(--page-bg)] p-4 font-mono text-sm leading-6 text-90 outline-none transition dark:border-white/10"
				></textarea>
			</section>
		</div>

		<section class="border-t border-[var(--line-divider)] p-4 md:p-5">
			<div class="mb-3 flex items-center justify-between gap-3">
				<h2 class="text-base font-bold text-90">预览</h2>
				<p class="text-sm text-50">预览内容已过滤危险脚本</p>
			</div>
			<div data-preview class="custom-md min-h-40 rounded-lg border border-black/10 bg-[var(--page-bg)] px-5 py-4 text-90 dark:border-white/10">
				<p class="text-50">转换后将在这里显示预览。</p>
			</div>
		</section>

		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line-divider)] px-4 py-3 md:px-5">
			<p data-status class="text-sm text-50">等待输入 Markdown 内容</p>
			<p class="text-sm text-50">本地转换，不上传服务器</p>
		</div>
	</markdown-html-tool>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">常见问题</h2>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div>
				<h3 class="font-bold text-90">支持哪些 Markdown 语法？</h3>
				<p class="mt-2 leading-7 text-75">
					支持标题、段落、引用、列表、链接、图片、代码块、表格等常见 Markdown 语法。
				</p>
			</div>
			<div>
				<h3 class="font-bold text-90">为什么 HTML 源码和预览不完全一样？</h3>
				<p class="mt-2 leading-7 text-75">
					HTML 源码保留转换结果；预览区会过滤潜在危险标签和属性，避免脚本执行。
				</p>
			</div>
		</div>
	</section>

	<section class="card-base mt-4 px-6 py-6 md:px-9">
		<h2 class="text-xl font-bold text-90">相关工具</h2>
		<div class="mt-3 flex flex-wrap gap-2">
			<a href="/tools/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">在线工具箱</a>
			<a href="/tools/json-format/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">JSON 格式化</a>
			<a href="/tools/base64/" class="btn-regular rounded-lg px-3 py-2 text-sm font-medium">Base64 编码解码</a>
		</div>
	</section>
</MainGridLayout>
