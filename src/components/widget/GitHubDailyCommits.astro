---
import { Icon } from "astro-icon/components";

const user = "wxy20021116";
const platforms = [
	{
		id: "github",
		name: "GitHub",
		icon: "fa6-brands:github",
		url: `https://github.com/${user}`,
		endpoint: `/api/github/contributions?user=${user}&days=14`,
		chart: "bars",
		rangeLabel: "14 天前",
	},
	{
		id: "gitee",
		name: "Gitee",
		icon: "",
		url: `https://gitee.com/${user}`,
		endpoint: `/api/gitee/contributions?user=${user}&days=60`,
		chart: "heatmap",
		rangeLabel: "60 天前",
	},
];
---

<daily-commit-widget class="card-base block p-4" data-user={user}>
	<div class="flex items-center justify-between gap-3">
		<div class="flex items-center gap-2 min-w-0">
			<Icon name="fa6-solid:code-commit" class="text-[1.1rem] text-neutral-700 dark:text-neutral-200"></Icon>
			<div class="font-bold text-neutral-900 dark:text-neutral-50 transition truncate">每日提交</div>
		</div>
		<div data-total-summary class="text-xs text-neutral-400 transition">GitHub + Gitee</div>
	</div>

	<div class="mt-4 flex flex-col gap-4">
		{platforms.map((platform) => (
			<div
				class="daily-commit-source"
				data-source={platform.id}
				data-endpoint={platform.endpoint}
				data-chart={platform.chart}
			>
				<div class="grid grid-cols-[auto_1fr_auto] gap-x-3 items-center">
					<div data-today-count class="text-3xl leading-none font-black text-[var(--primary)] tabular-nums">--</div>
					<div class="min-w-0">
						<div class="flex items-center gap-1.5 text-sm font-semibold text-neutral-700 dark:text-neutral-200 transition">
							{platform.icon
								? <Icon name={platform.icon} class="text-[1rem]"></Icon>
								: <span class="gitee-mark">G</span>}
							<span>{platform.name}</span>
						</div>
						<div data-summary class="text-xs text-neutral-400 transition">正在读取数据...</div>
					</div>
					<a
						href={platform.url}
						target="_blank"
						rel="noopener"
						aria-label={`Open ${user} on ${platform.name}`}
						class="btn-plain h-8 w-8 rounded-lg shrink-0"
					>
						<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.85rem]"></Icon>
					</a>
				</div>
				<div
					data-chart-container
					class:list={[
						"mt-3",
						platform.chart === "heatmap"
							? "daily-commit-heatmap"
							: "daily-commit-bars flex h-10 items-end gap-1.5",
					]}
					aria-label={`${platform.name} 最近每日提交数量`}
				>
					{Array.from({ length: platform.chart === "heatmap" ? 60 : 14 }).map(() => (
						<span class:list={[
							platform.chart === "heatmap" ? "daily-commit-cell" : "daily-commit-bar",
							"skeleton-bar",
						]}></span>
					))}
				</div>
				<div class="mt-2 flex justify-between text-[0.7rem] text-neutral-400 transition">
					<span>{platform.rangeLabel}</span>
					<span>今天</span>
				</div>
			</div>
		))}
	</div>
</daily-commit-widget>

<style>
	daily-commit-widget .gitee-mark {
		display: inline-flex;
		width: 1rem;
		height: 1rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.25rem;
		background: #c71d23;
		color: white;
		font-size: 0.68rem;
		font-weight: 800;
		line-height: 1;
	}

	daily-commit-widget .daily-commit-source + .daily-commit-source {
		padding-top: 1rem;
		border-top: 1px solid color-mix(in oklch, currentColor 10%, transparent);
	}

	daily-commit-widget .daily-commit-bar {
		width: 100%;
		min-width: 0.45rem;
		border-radius: 999px 999px 0.25rem 0.25rem;
		background: color-mix(in oklch, oklch(0.78 0.15 var(--hue)) 72%, transparent);
		transition: height 240ms ease, background 240ms ease, opacity 240ms ease;
	}

	daily-commit-widget .daily-commit-heatmap {
		display: grid;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, minmax(0, 0.62rem));
		grid-auto-columns: minmax(0, 0.62rem);
		gap: 0.2rem;
		justify-content: space-between;
	}

	daily-commit-widget .daily-commit-cell {
		width: 0.62rem;
		height: 0.62rem;
		border-radius: 0.16rem;
		background: color-mix(in oklch, currentColor 14%, transparent);
		color: rgb(163 163 163);
		transition: background 240ms ease, opacity 240ms ease;
	}

	daily-commit-widget .daily-commit-bar[data-empty="true"] {
		background: color-mix(in oklch, currentColor 14%, transparent);
		color: rgb(163 163 163);
	}

	daily-commit-widget .daily-commit-cell[data-level="1"] {
		background: #d9ef8b;
	}

	daily-commit-widget .daily-commit-cell[data-level="2"] {
		background: #91cf60;
	}

	daily-commit-widget .daily-commit-cell[data-level="3"] {
		background: #4daf4a;
	}

	daily-commit-widget .daily-commit-cell[data-level="4"] {
		background: #1b7837;
	}

	daily-commit-widget .skeleton-bar {
		height: 22%;
		opacity: 0.35;
	}

	daily-commit-widget .daily-commit-cell.skeleton-bar {
		height: 0.62rem;
	}
</style>

<script>
	// @ts-nocheck
	class DailyCommitWidget extends HTMLElement {
		connectedCallback() {
			if (this.dataset.loaded === "true") return;
			this.dataset.loaded = "true";
			this.load();
		}

		async load() {
			const rows = Array.from(this.querySelectorAll(".daily-commit-source"));
			await Promise.all(rows.map((row) => this.loadRow(row)));
			this.renderTotal(rows);
		}

		async loadRow(row) {
			const endpoint = row.dataset.endpoint;
			if (!endpoint) return;

			try {
				const response = await fetch(endpoint, { cache: "no-store" });
				const payload = await response.json();

				if (!response.ok || !payload.ok) {
					throw new Error(payload.message || "数据读取失败");
				}

				this.renderRow(row, payload);
			} catch (error) {
				const summary = row.querySelector("[data-summary]");
				if (summary) summary.textContent = error instanceof Error ? error.message : "数据读取失败";
				this.renderEmptyBars(row);
			}
		}

		renderTotal(rows) {
			const totalSummary = this.querySelector("[data-total-summary]");
			const todayTotal = rows.reduce((sum, row) => sum + Number(row.dataset.today || 0), 0);
			if (totalSummary) totalSummary.textContent = `今日合计 ${todayTotal} 次`;
		}

		renderEmptyBars(row) {
			row.querySelectorAll(".daily-commit-bar, .daily-commit-cell").forEach((item) => {
				if (!(item instanceof HTMLElement)) return;
				item.classList.remove("skeleton-bar");
				item.setAttribute("data-empty", "true");
				if (item.classList.contains("daily-commit-bar")) item.style.height = "12%";
			});
		}

		renderRow(row, payload) {
			const days = Array.isArray(payload.days) ? payload.days : [];
			const today = payload.today?.count ?? days.at(-1)?.count ?? 0;
			const recent7 = days.slice(-7).reduce((sum, day) => sum + Number(day.count || 0), 0);
			const total = days.reduce((sum, day) => sum + Number(day.count || 0), 0);
			const maxCount = Math.max(1, ...days.map((day) => Number(day.count || 0)));

			row.dataset.today = String(today);
			const todayCount = row.querySelector("[data-today-count]");
			const summary = row.querySelector("[data-summary]");
			const chart = row.querySelector("[data-chart-container]");

			if (todayCount) todayCount.textContent = String(today);
			if (summary) summary.textContent = row.dataset.chart === "heatmap"
				? `近 ${days.length} 天 ${total} 次`
				: `近 7 天 ${recent7} 次`;
			if (!(chart instanceof HTMLElement)) return;

			chart.innerHTML = "";
			if (row.dataset.chart === "heatmap") {
				this.renderHeatmap(chart, days, maxCount);
				return;
			}

			this.renderBars(chart, days, maxCount);
		}

		renderBars(chart, days, maxCount) {
			for (const day of days) {
				const count = Number(day.count || 0);
				const bar = document.createElement("span");
				bar.className = "daily-commit-bar";
				bar.style.height = `${count === 0 ? 12 : Math.max(22, Math.round((count / maxCount) * 100))}%`;
				bar.title = `${day.date}: ${count} 次`;
				bar.setAttribute("aria-label", `${day.date}: ${count} 次`);
				if (count === 0) bar.dataset.empty = "true";
				chart.appendChild(bar);
			}
		}

		renderHeatmap(chart, days, maxCount) {
			for (const day of days) {
				const count = Number(day.count || 0);
				const cell = document.createElement("span");
				cell.className = "daily-commit-cell";
				cell.dataset.level = String(this.getHeatmapLevel(count, maxCount));
				cell.title = `${day.date}: ${count} 次`;
				cell.setAttribute("aria-label", `${day.date}: ${count} 次`);
				if (count === 0) cell.dataset.empty = "true";
				chart.appendChild(cell);
			}
		}

		getHeatmapLevel(count, maxCount) {
			if (count <= 0) return 0;
			if (count >= maxCount * 0.75) return 4;
			if (count >= maxCount * 0.45) return 3;
			if (count >= maxCount * 0.2) return 2;
			return 1;
		}
	}

	if (!customElements.get("daily-commit-widget")) {
		customElements.define("daily-commit-widget", DailyCommitWidget);
	}
</script>
