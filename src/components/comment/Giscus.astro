---
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

// Renders the Giscus container only. The actual giscus client script is
// (re)injected by the global loader in Layout.astro, so it keeps working
// across Swup page transitions and syncs with the light/dark theme.
const g = commentConfig.giscus;
const enabled =
	commentConfig.enable &&
	!!g.repo &&
	!!g.repoId &&
	!!g.category &&
	!!g.categoryId;
---
{enabled && (
    <section class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 mb-4 onload-animation" aria-labelledby="comments-title">
        <div class="flex items-center gap-2 mb-4">
            <Icon name="material-symbols:chat-bubble-outline-rounded" class="text-[1.5rem] text-[var(--primary)]" aria-hidden="true" />
            <h2 id="comments-title" class="text-xl font-bold text-black/90 dark:text-white/90">{i18n(I18nKey.comments)}</h2>
        </div>
        <div
            id="giscus-container"
            class="giscus min-h-[8rem]"
            data-repo={g.repo}
            data-repo-id={g.repoId}
            data-category={g.category}
            data-category-id={g.categoryId}
            data-mapping={g.mapping}
            data-strict={g.strict ? "1" : "0"}
            data-reactions-enabled={g.reactionsEnabled ? "1" : "0"}
            data-emit-metadata={g.emitMetadata ? "1" : "0"}
            data-input-position={g.inputPosition}
            data-lang={g.lang}
        >
        </div>
    </section>
)}
